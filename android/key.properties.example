# Copy to android/key.properties (gitignored) for Play Store / release signing.
# Never commit real passwords or the keystore file.
#
# storePassword=***
# keyPassword=***
# keyAlias=upload
# storeFile is relative to android/app/ (e.g. ../upload-keystore.jks if the
# .jks lives under android/).
#
# Generate:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# CI: store the jks as a secret and write key.properties in the workflow before
# `flutter build appbundle --release`. For compile-only CI without secrets, set
# ALLOW_DEBUG_SIGNING=true (not valid for store uploads).
storePassword=
keyPassword=
keyAlias=upload
storeFile=../upload-keystore.jks
